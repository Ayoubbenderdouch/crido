# ───────────────────────────────────────────────
# Crido — root .gitignore (covers all 4 sub-projects)
# Each sub-project also keeps its own framework .gitignore
# ───────────────────────────────────────────────

# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# Environment / secrets
.env
.env.*
!.env.example

# ── Backend (Laravel) ──
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot
backend/storage/*.key
backend/storage/pail/
backend/.phpunit.result.cache
backend/auth.json

# ── Dashboards (React / Vite) ──
dashboard/admin/node_modules/
dashboard/admin/dist/
dashboard/vendor/node_modules/
dashboard/vendor/dist/

# ── Flutter app ──
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.pub-cache/
app/ios/Pods/
app/ios/.symlinks/
app/android/.gradle/
app/android/local.properties
app/*.iml

# Logs
*.log
npm-debug.log*
